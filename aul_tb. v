`timescale 1ns/1ps

module alu_tb;

reg [3:0] A, B;
reg [2:0] sel;
wire [3:0] Y;

alu uut (
    .A(A),
    .B(B),
    .sel(sel),
    .Y(Y)
);

initial begin
    A = 4'b0011; B = 4'b0010; sel = 3'b000; #10;
    $display("ADD: A=%d B=%d Y=%d", A, B, Y);

    sel = 3'b001; #10;
    $display("SUB: A=%d B=%d Y=%d", A, B, Y);

    sel = 3'b010; #10;
    $display("AND: A=%d B=%d Y=%d", A, B, Y);

    sel = 3'b011; #10;
    $display("OR: A=%d B=%d Y=%d", A, B, Y);

    sel = 3'b100; #10;
    $display("XOR: A=%d B=%d Y=%d", A, B, Y);

    sel = 3'b101; #10;
    $display("NOT: A=%d Y=%d", A, Y);

    $finish;
end

endmodule
